<Window x:Class="WcUiWpf.Windows.MusicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border x:Name="RootBorder" CornerRadius="20" Background="Transparent"
            BorderBrush="#35FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.4" />
        </Border.Effect>
        <Grid x:Name="MusicGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部拖动区 + 关闭按钮 -->
            <Grid Grid.Row="0" Height="32" Cursor="Hand">
                <TextBlock x:Name="HeaderLabel" Text="♪ 正在播放" Foreground="#60FFFFFF" FontSize="11"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button x:Name="BtnClose" Content="✕" Width="24" Height="24"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#60FFFFFF" BorderThickness="0"
                        FontSize="10" Cursor="Hand" Padding="0" />
            </Grid>

            <!-- 中部：封面 + 歌名 + 歌词 -->
            <Grid Grid.Row="1" Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 专辑封面 -->
                <Border x:Name="CoverBorder" Grid.Row="0" Width="180" Height="180" CornerRadius="16"
                        HorizontalAlignment="Center" Margin="0,8,0,16"
                        Background="#20FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                    </Border.Effect>
                    <Grid>
                        <TextBlock x:Name="CoverPlaceholder" Text="♫" FontSize="56" Foreground="#30FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- 歌名 + 艺术家 -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock x:Name="TrackTitle" Text="未在播放" Foreground="#F0FFFFFF"
                               FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="280" />
                    <TextBlock x:Name="TrackArtist" Text="—" Foreground="#70FFFFFF"
                               FontSize="11" TextAlignment="Center" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="280" />
                </StackPanel>

                <!-- 歌词区域 -->
                <Border Grid.Row="2" CornerRadius="12" Background="Transparent" Margin="0,4,0,0">
                    <ScrollViewer x:Name="LyricScroll" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                        <ItemsControl x:Name="LyricItems" Padding="8,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="11"
                                               TextAlignment="Center" Margin="0,3" TextWrapping="Wrap"
                                               x:Name="LyricLine" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="LyricLine" Property="Foreground" Value="{Binding ActiveForeground}" />
                                            <Setter TargetName="LyricLine" Property="FontSize" Value="12" />
                                            <Setter TargetName="LyricLine" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 底部：进度条 + 控制按钮 -->
            <StackPanel Grid.Row="2" Margin="16,8,16,16">
                <!-- 进度条 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeCurrent" Text="0:00" Foreground="#50FFFFFF" FontSize="9"
                               Grid.Column="0" VerticalAlignment="Center" />
                    <ProgressBar x:Name="ProgressBar" Grid.Column="1" Height="3" Margin="8,0"
                                 Minimum="0" Maximum="100" Value="0" Foreground="#80C0E0FF"
                                 Background="#20FFFFFF" BorderThickness="0" />
                    <TextBlock x:Name="TimeTotal" Text="0:00" Foreground="#50FFFFFF" FontSize="9"
                               Grid.Column="2" VerticalAlignment="Center" />
                </Grid>

                <!-- 控制按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnPrev" Content="⏮" Width="36" Height="36"
                            Background="Transparent" Foreground="#C0FFFFFF" BorderThickness="0"
                            FontSize="14" Cursor="Hand" Padding="0" Margin="4,0" />
                    <Button x:Name="BtnPlay" Content="▶" Width="44" Height="44" Margin="8,0"
                            Background="#3580C0FF" Foreground="White" BorderThickness="0"
                            FontSize="16" Cursor="Hand" Padding="0" />
                    <Button x:Name="BtnNext" Content="⏭" Width="36" Height="36"
                            Background="Transparent" Foreground="#C0FFFFFF" BorderThickness="0"
                            FontSize="14" Cursor="Hand" Padding="0" Margin="4,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
