<Window x:Class="WcUiWpf.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
    <Border x:Name="RootBorder" CornerRadius="20" Background="#FF2D2D30"
            BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="TitleBar" Cursor="Hand" Background="Transparent">
                <TextBlock Text="设置" Foreground="#F0FFFFFF" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="20,0,0,0" />
                <Button x:Name="BtnClose" Content="✕" Width="28" Height="28"
                        HorizontalAlignment="Right" Margin="0,0,12,0"
                        Background="Transparent" Foreground="#80FFFFFF" BorderThickness="0"
                        FontSize="12" Cursor="Hand" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0">
                <StackPanel>
                    <TextBlock Text="数据管理" Foreground="#007ACC" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,8" />
                    <Button x:Name="BtnClearLogs" Content="清除日志缓存" Height="32" Margin="0,4,0,8"
                            Background="Transparent" Foreground="#A0FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                            FontSize="12" Cursor="Hand" HorizontalContentAlignment="Center" />

                    <TextBlock Text="关于" Foreground="#007ACC" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,8" />
                    <TextBlock Text="Wallpaper Connecter v0.1.0" Foreground="#A0FFFFFF" FontSize="12" Margin="0,2" />
                    <TextBlock Text="创作者：周璟琦-Jett" Foreground="#A0FFFFFF" FontSize="12" Margin="0,2" />
                    <TextBlock Text="GPL-3.0 开源" Foreground="#60FFFFFF" FontSize="11" Margin="0,2" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Background="#08FFFFFF">
                <Button x:Name="BtnRestore" Content="恢复默认" Width="90" Height="32"
                        HorizontalAlignment="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                        Background="Transparent" Foreground="#80FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"

FontSize="12" Cursor="Hand" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                    <Button x:Name="BtnCancel" Content="取消" Width="72" Height="32" Margin="0,0,8,0"
                            Background="Transparent" Foreground="#A0FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
    
FontSize="12" Cursor="Hand" VerticalAlignment="Center" />
                    <Button x:Name="BtnConfirm" Content="确定" Width="72" Height="32"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
    
FontSize="12" Cursor="Hand" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <!-- 未保存更改提示（自定义模态，非系统弹窗） -->
    <Grid x:Name="UnsavedModal" Visibility="Collapsed" Background="#80000000">
        <Border Width="300" Height="140" CornerRadius="14" Background="#FF3C3C3C"
                BorderBrush="#40FFFFFF" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="20">
                <TextBlock Text="未保存的更改" Foreground="#F0FFFFFF" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="有未保存的更改，是否保存？" Foreground="#A0FFFFFF" FontSize="12" Margin="0,8,0,16" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ModalDontSave" Content="不保存" Width="72" Height="28" Margin="0,0,8,0"
                            Background="Transparent" Foreground="#A0FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"

FontSize="11" Cursor="Hand" />
                    <Button x:Name="ModalSave" Content="保存" Width="72" Height="28"
                            Background="#007ACC" Foreground="White" BorderThickness="0"

FontSize="11" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
