<Window x:Class="WcInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallpaper Connecter Setup Wizard"
        Width="640" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Frame x:Name="ContentFrame" Grid.Row="0" NavigationUIVisibility="Hidden"/>

        <Border Grid.Row="1" Background="#E8E8E8" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack" Content="Back" Click="BtnBack_Click" MinWidth="80" Margin="0,0,8,0"/>
                    <Button x:Name="BtnNext" Content="Next" Click="BtnNext_Click" MinWidth="80" Margin="0,0,8,0"/>
                    <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" MinWidth="80"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>