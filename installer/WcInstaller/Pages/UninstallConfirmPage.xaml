<Page x:Class="WcInstaller.Pages.UninstallConfirmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Uninstall Wisp" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock x:Name="PathText" FontSize="14" Foreground="#333" Margin="0,0,0,8"/>
            <TextBlock Text="Are you sure you want to uninstall?？All program files will be removed。" FontSize="13" Foreground="#666" Margin="0,0,0,24"/>
            <TextBlock Text="Click Next to begin。" FontSize="13" Foreground="#888"/>
        </StackPanel>
    </Grid>
</Page>