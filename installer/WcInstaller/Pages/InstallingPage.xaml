<Page x:Class="WcInstaller.Pages.InstallingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Installing......" FontSize="20" FontWeight="Bold" Margin="0,0,0,24"/>
            <ProgressBar x:Name="Progress" Height="24" Margin="0,0,0,16"/>
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="#666"/>
        </StackPanel>
    </Grid>
</Page>