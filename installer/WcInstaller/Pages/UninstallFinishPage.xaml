<Page x:Class="WcInstaller.Pages.UninstallFinishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Uninstall Complete！" FontSize="24" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,16"/>
            <TextBlock Text="Wisp has been removed。" FontSize="14" Foreground="#333" Margin="0,0,0,32"/>
            <TextBlock Text="Click Finish to close uninstaller。" FontSize="13" Foreground="#888"/>
        </StackPanel>
    </Grid>
</Page>