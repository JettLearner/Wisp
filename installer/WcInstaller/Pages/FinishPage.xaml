<Page x:Class="WcInstaller.Pages.FinishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Installation Complete！" FontSize="24" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,16"/>
            <TextBlock Text="Wisp has been successfully installed。" FontSize="14" Foreground="#333" Margin="0,0,0,8"/>
            <TextBlock Text="You can launch from desktop or start menu。" FontSize="13" Foreground="#666" Margin="0,0,0,32"/>
            <TextBlock Text="Click Finish to close setup。" FontSize="13" Foreground="#888"/>
        </StackPanel>
    </Grid>
</Page>